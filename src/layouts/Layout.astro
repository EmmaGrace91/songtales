---
import { IMAGES, SITE } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${SITE.name} — Personal songs for the people you love`, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
// Social preview images must be absolute URLs — Facebook and friends fetch
// them from their own servers, so a root-relative path resolves to nothing.
const socialImage = new URL(IMAGES.logo, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={IMAGES.logo} type="image/jpeg" />
    <meta name="theme-color" content="#f7f3ee" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="720" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="The Songtales emblem — a piano and quill in a circle" />
    {/* The emblem is square, so a summary card suits it better than the
        wide variant, which would crop or letterbox it. */}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
