---
import { IDEA_CLOSE, IDEA_INTRO, IDEA_LIST_LEAD, OCCASIONS } from '../content';
import { HEARTFELT_EXAMPLE_URL, HUMOROUS_EXAMPLE_URL } from '../site';
---

<section class="section" id="the-idea" aria-labelledby="idea-heading">
  <div class="shell">
    <p class="eyebrow">The idea</p>
    <h2 class="section-title" id="idea-heading">An original song, written to tell your story.</h2>

    <div class="idea-body">
      <div class="prose idea-intro">
        {IDEA_INTRO.map((paragraph) => <p>{paragraph}</p>)}
        <p>{IDEA_LIST_LEAD}</p>
      </div>

      <ul class="occasions">
        {OCCASIONS.map((occasion) => <li>{occasion}</li>)}
      </ul>
    </div>

    <div class="idea-close">
      <p>{IDEA_CLOSE}</p>
      <p>
        <a class="idea-example" href={HUMOROUS_EXAMPLE_URL} target="_blank" rel="noopener">
          Humorous<span class="visually-hidden"> — hear a funny example on YouTube</span></a>,{' '}
        <a class="idea-example" href={HEARTFELT_EXAMPLE_URL} target="_blank" rel="noopener">
          heartfelt<span class="visually-hidden"> — hear a heartfelt example on YouTube</span></a>,
        or both.
      </p>
    </div>
  </div>
</section>

<style>
  .idea-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .idea-intro {
    max-width: 36rem;
  }

  .occasions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .occasions li {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .idea-close {
    margin-top: 2rem;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    color: var(--wine);
  }

  .idea-close p {
    margin: 0;
  }

  .idea-close p + p {
    margin-top: 0.35rem;
  }

  /* The link sits in wine text, so it needs an underline to read as a link. */
  .idea-example {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .idea-example:hover {
    color: var(--wine-dark);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 800px) {
    .idea-body {
      grid-template-columns: 1fr;
    }
  }
</style>
