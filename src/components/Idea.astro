---
import { IDEA_CLOSE, IDEA_INTRO, IDEA_LIST_LEAD, OCCASIONS } from '../content';
---

<section class="section" id="the-idea" aria-labelledby="idea-heading">
  <div class="shell">
    <p class="eyebrow">The idea</p>
    <h2 class="section-title" id="idea-heading">An original song, written for one person.</h2>

    <div class="idea-body">
      <div class="prose idea-intro">
        {IDEA_INTRO.map((paragraph) => <p>{paragraph}</p>)}
        <p>{IDEA_LIST_LEAD}</p>
      </div>

      <ul class="occasions">
        {OCCASIONS.map((occasion) => <li>{occasion}</li>)}
      </ul>
    </div>

    <p class="idea-close">{IDEA_CLOSE}</p>
  </div>
</section>

<style>
  .idea-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .idea-intro {
    max-width: 36rem;
  }

  .occasions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .occasions li {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .idea-close {
    margin-top: 2rem;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    color: var(--wine);
  }

  @media (max-width: 800px) {
    .idea-body {
      grid-template-columns: 1fr;
    }
  }
</style>
