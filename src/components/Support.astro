---
import { SUPPORT_GST_NOTE, SUPPORT_INTRO, SUPPORT_NOTES, SUPPORT_TIERS } from '../content';
import { TALLY_FORM_URL } from '../site';
---

<section class="section" id="support" aria-labelledby="support-heading">
  <div class="shell support-inner">
    <div class="support-copy">
      <p class="eyebrow">Support the work</p>
      <h2 class="section-title" id="support-heading">No fixed price. Give what feels right.</h2>
      <p class="prose">{SUPPORT_INTRO}</p>
    </div>

    <div class="card support-card">
      <dl class="tiers">
        {
          SUPPORT_TIERS.map((tier) => (
            <div class:list={['tier', tier.base && 'tier-base']}>
              <dt>
                <span class="tier-label">{tier.label}</span>
                {tier.detail && <span class="tier-detail">{tier.detail}</span>}
              </dt>
              <dd>{tier.amount}</dd>
            </div>
          ))
        }
      </dl>

      <p class="gst-note">{SUPPORT_GST_NOTE}</p>

      <ul class="notes">
        {SUPPORT_NOTES.map((note) => <li>{note}</li>)}
      </ul>

      <a class="btn btn-primary support-cta" href={TALLY_FORM_URL} target="_blank" rel="noopener">
        Request a song
      </a>
    </div>
  </div>
</section>

<style>
  .support-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .support-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .tiers {
    margin: 0;
  }

  .tier {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .tier:last-of-type {
    border-bottom: 0;
  }

  .tier dt {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .tier dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--wine);
    white-space: nowrap;
  }

  .tier-base .tier-label {
    font-weight: 600;
  }

  .tier-label {
    font-size: 1rem;
  }

  .tier-detail {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .gst-note {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .notes {
    margin: 1.25rem 0 0;
    padding: 1.1rem 1.25rem 1.1rem 2.4rem;
    background: rgba(139, 58, 58, 0.05);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.9063rem;
    display: grid;
    gap: 0.55rem;
  }

  .support-cta {
    margin-top: 1.5rem;
  }
</style>
