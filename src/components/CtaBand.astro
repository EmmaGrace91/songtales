---
import { CONTRIBUTE_URL, SITE, TALLY_FORM_URL } from '../site';
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="shell cta-inner">
    <h2 class="cta-title" id="cta-heading">Tell me who the song is for.</h2>
    <p class="cta-sub">{SITE.neverAi}</p>

    <div class="cta-actions">
      <a class="btn btn-on-wine" href={TALLY_FORM_URL} target="_blank" rel="noopener">
        Request a song
      </a>
      {
        CONTRIBUTE_URL && (
          <a class="btn btn-outline-on-wine" href={CONTRIBUTE_URL} target="_blank" rel="noopener">
            Contribute
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--wine);
    color: #fffdf9;
    padding-block: clamp(3rem, 7vw, 4.5rem);
    text-align: center;
  }

  .cta-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #fffdf9;
    margin-bottom: 0.75rem;
  }

  .cta-sub {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(255, 253, 249, 0.75);
    margin-bottom: 1.9rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }
</style>
