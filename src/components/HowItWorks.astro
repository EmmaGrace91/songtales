---
import { STEPS } from '../content';
---

<section class="section" id="how-it-works" aria-labelledby="how-heading">
  <div class="shell">
    <p class="eyebrow">How it works</p>
    <h2 class="section-title" id="how-heading">Three steps, at your pace.</h2>

    <ol class="steps">
      {
        STEPS.map((step) => (
          <li class="card step">
            <span class="step-number" aria-hidden="true">{step.number}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .step {
    padding: 1.75rem;
  }

  .step-number {
    display: block;
    font-family: var(--serif);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--wine);
    opacity: 0.55;
    margin-bottom: 0.9rem;
  }

  .step-title {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }

  .step-body {
    color: var(--muted);
    font-size: 0.9688rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
